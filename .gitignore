# ---------------------------------------------------------------------------
# Compagnon de courses — monorepo .gitignore
# Gradle/Kotlin · Android · Xcode
# ---------------------------------------------------------------------------

# --- OS ---------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
Desktop.ini

# --- Gradle -----------------------------------------------------------------
.gradle
/build
build/
!gradle/wrapper/gradle-wrapper.jar
# Machine-specific SDK path (sdk.dir=...).
/local.properties
local.properties

# --- Kotlin -----------------------------------------------------------------
# Kotlin 2.x project-level state (daemon sessions, error logs).
.kotlin/
*.hprof

# --- IntelliJ IDEA / Android Studio / Fleet ---------------------------------
*.iml
*.ipr
*.iws
out/
.fleet/
# Ignore .idea/ except the shared configuration listed below.
/.idea/*
!/.idea/codeStyles/
!/.idea/inspectionProfiles/
!/.idea/runConfigurations/
!/.idea/dictionaries/
!/.idea/copyright/
!/.idea/scopes/
!/.idea/fileTemplates/
!/.idea/externalDependencies.xml
!/.idea/vcs.xml
# Personal or generated files, even inside the shared folders above.
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
/.idea/**/shelf/
/.idea/**/usage.statistics.xml

# --- Android ----------------------------------------------------------------
/captures
.externalNativeBuild
.cxx
*.apk
*.aab
*.ap_
*.dex
*.apks
# Signing material is never versioned (CI secrets / password manager).
*.jks
*.keystore
keystore.properties
signing.properties
# Firebase configuration comes with the FCM work (V0+): provided per environment, not committed.
google-services.json
GoogleService-Info.plist

# --- Xcode / iOS ------------------------------------------------------------
xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive
*.mobileprovision
*.p8
*.p12
# Swift Package Manager.
.build/
.swiftpm/
# Note: iosApp.xcodeproj/xcshareddata/ (shared "iosApp" scheme, built by the CI) IS versioned.
# Local Xcode overrides (e.g. a personal DEVELOPMENT_TEAM).
*.local.xcconfig

# --- Fastlane (later sprints) -----------------------------------------------
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# --- Logs -------------------------------------------------------------------
*.log
logs/

# --- Local tooling ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.claude/settings.local.json
__pycache__/
.venv/
*.swp
*~
