<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: the app's database (lists, history, household profile) and preferences go to the Google cloud backup
    and to a new phone. The published app has no server (ADR-013): the system backup is the only way to keep them.
    Nothing secret is stored (no account, no token). Android 11 and lower: res/xml/backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
