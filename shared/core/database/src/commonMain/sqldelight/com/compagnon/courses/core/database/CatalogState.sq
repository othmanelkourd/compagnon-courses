-- Which projection of the catalog the local catalog tables hold: the one bundled in the app for the device's
-- (country, locale). Installing another pair replaces the tables. synced_at is when it was installed.
-- Times are epoch milliseconds (UTC).
CREATE TABLE catalog_state (
    country TEXT NOT NULL,
    locale TEXT NOT NULL,
    version INTEGER NOT NULL,
    synced_at INTEGER NOT NULL,
    PRIMARY KEY (country, locale)
);

selectCurrent:
SELECT * FROM catalog_state ORDER BY synced_at DESC LIMIT 1;

selectFor:
SELECT * FROM catalog_state WHERE country = :country AND locale = :locale;

upsert:
INSERT OR REPLACE INTO catalog_state (country, locale, version, synced_at)
VALUES (:country, :locale, :version, :syncedAt);

deleteAll:
DELETE FROM catalog_state;
